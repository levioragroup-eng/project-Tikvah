; Engine configuration file.
; TIKVAH 2.0 — Godot 4.x rebuild. Track B / competition vertical slice.

config_version=5

[application]

config/name="TIKVAH 2.0"
config/description="A Christian cozy life-sim: live the village rhythm, restore the Garden of Hope."
run/main_scene="res://scenes/world/village.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.08, 0.1, 0.16, 1)
